            }
            lines {
              text: "      const baseAngle = Math.atan2(targetPointY - state.originY, targetPointX - state.originX);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // 2. Compute smooth mouse parallax sway (\302\261maxSwayDeg)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const maxSwayRad = (maxSwayDeg * Math.PI) / 180;"
