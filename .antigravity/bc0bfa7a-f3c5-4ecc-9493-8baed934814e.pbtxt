            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Handle cursor movement with smooth normalized coordinates"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const handlePointerMove = useCallback((e: MouseEvent | TouchEvent) => {"
