            }
            lines {
              text: "      const bounceX = width * 0.12;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bounceY = height * 0.88;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bounceRad = Math.min(380, width * 0.38);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const bounceGrad = ctx.createRadialGradient(bounceX, bounceY, 0, bounceX, bounceY, bounceRad);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      bounceGrad.addColorStop(0.00, hexToRgba(secondaryColor, 0.22 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      bounceGrad.addColorStop(0.40, hexToRgba(coreColor, 0.10 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      bounceGrad.addColorStop(1.00, \'rgba(11, 13, 25, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.fillStyle = bounceGrad;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.arc(bounceX, bounceY, bounceRad, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      // PASS 6: Floating Star / Dust Particles"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // - Scattered, faint twinkling stars drifting slowly upward"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // - Catching the light inside the cyan/purple beam with boosted brightness & soft cyan glint"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (showParticles && state.particles.length > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const particles = state.particles;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const beamConeHalfAngle = halfSpread * 1.18;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        for (let i = 0; i < particles.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const p = particles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Slow upward float and gentle ambient wave"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          p.y += p.speedY;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          p.x += p.speedX + Math.sin(time * 0.45 + p.driftPhase) * 0.0001;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Wrap boundaries organically"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (p.y < -0.02) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            p.y = 1.02;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            p.x = Math.random();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (p.x < -0.02) p.x = 1.02;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (p.x > 1.02) p.x = -0.02;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const px = p.x * width;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const py = p.y * height;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Calculate angle and distance from beam origin"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dx = px - ox;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dy = py - oy;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const dist = Math.hypot(dx, dy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const pAngle = Math.atan2(dy, dx);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Angular difference relative to beam direction"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let diff = pAngle - angle;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          while (diff > Math.PI) diff -= Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          while (diff < -Math.PI) diff += Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const absDiff = Math.abs(diff);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Determine if particle is inside the beam"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let inBeam = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (absDiff < beamConeHalfAngle && dist < reach * 0.95) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const lateral = 1 - absDiff / beamConeHalfAngle;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const longitudinal = Math.max(0, 1 - dist / (reach * 0.95));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            inBeam = Math.pow(lateral, 1.2) * (0.35 + 0.65 * longitudinal);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Twinkle oscillation"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const twinkle = 0.72 + 0.28 * Math.sin(time * p.twinkleFreq + p.twinklePhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (inBeam > 0.05) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Particle catches the light inside the beam"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const beamBoost = inBeam * 0.65 * intensity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const alpha = Math.min(1.0, (p.baseAlpha + beamBoost) * twinkle);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const renderedRadius = p.radius * (1 + inBeam * 0.35);"
