            lines {
              text: "        const px = Math.cos(theta) * r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const py = Math.sin(theta) * r;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
