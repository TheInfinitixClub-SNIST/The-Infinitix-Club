              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const floorX = width / 2;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const floorY = height * 0.95;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      const floorRadius = Math.min(520, width * 0.65);"
