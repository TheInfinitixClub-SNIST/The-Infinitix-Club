            }
            lines {
              text: "      const apertureGlow = ctx.createRadialGradient(ox, oy, 0, ox, oy, Math.min(220, width * 0.28));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      apertureGlow.addColorStop(0.00, hexToRgba(\'#ffffff\', 0.98 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      apertureGlow.addColorStop(0.15, hexToRgba(coreColor, 0.75 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      apertureGlow.addColorStop(0.45, hexToRgba(secondaryColor, 0.35 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      apertureGlow.addColorStop(1.00, \'rgba(11, 13, 25, 0)\');"
