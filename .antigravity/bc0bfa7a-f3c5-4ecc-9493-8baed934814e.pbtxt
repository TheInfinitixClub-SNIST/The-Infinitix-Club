              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      drawConePath(halfSpread * 1.6);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      const gradAmbient = ctx.createRadialGradient(ox, oy, 10, ox, oy, reach * 0.95);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      gradAmbient.addColorStop(0.0, hexToRgba(coreColor, 0.32 * intensity));"
