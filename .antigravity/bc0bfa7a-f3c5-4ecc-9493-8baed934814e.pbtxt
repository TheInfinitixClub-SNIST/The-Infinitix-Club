            lines {
              text: "      floorGrad.addColorStop(0.00, hexToRgba(secondaryColor, 0.26 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      floorGrad.addColorStop(0.38, hexToRgba(coreColor, 0.12 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      floorGrad.addColorStop(1.00, \'rgba(11, 13, 25, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ctx.fillStyle = floorGrad;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // Draw an elongated stage pool ellipse"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ctx.ellipse(floorX, floorY, floorRadius, floorRadius * 0.45, 0, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // PASS 6: Floating Star / Dust Particles"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // - Scattered, faint twinkling stars drifting slowly upward"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // - Brightening and catching soft cyan/violet glints as they pass through the central cone"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.closePath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gradRipple = ctx.createRadialGradient(0, 0, 0, 0, 0, waveRadius * 1.15);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradRipple.addColorStop(0.00, hexToRgba(\'#ffffff\', 0.98 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradRipple.addColorStop(0.12, hexToRgba(coreColor, 0.90 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradRipple.addColorStop(0.38, hexToRgba(coreColor, 0.58 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradRipple.addColorStop(0.70, hexToRgba(secondaryColor, 0.32 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradRipple.addColorStop(1.00, \'rgba(11, 13, 25, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fillStyle = gradRipple;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // PASS 5: Radiant Luminous Central Core Nucleus (White-hot cyan center)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.globalCompositeOperation = \'screen\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (\'filter\' in ctx) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        ctx.filter = \'blur(12px)\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const nucleusRadius = Math.min(85, minDim * 0.16) * pulseScale;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      const gradNucleus = ctx.createRadialGradient(cx, cy, 0, cx, cy, nucleusRadius);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradNucleus.addColorStop(0.00, hexToRgba(\'#ffffff\', 1.0 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradNucleus.addColorStop(0.20, hexToRgba(\'#e0ffff\', 0.95 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradNucleus.addColorStop(0.50, hexToRgba(coreColor, 0.75 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradNucleus.addColorStop(0.82, hexToRgba(secondaryColor, 0.30 * intensity));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      gradNucleus.addColorStop(1.00, \'rgba(11, 13, 25, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fillStyle = gradNucleus;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.arc(cx, cy, nucleusRadius, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // PASS 6: Energized Floating Star / Dust Particles"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // - Boosted motion speed (2x-3x)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // - Upward float with gentle orbital swirl"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      // - Igniting with brilliant electric cyan / neon violet glints as they traverse the central glow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (showParticles && state.particles.length > 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const particles = state.particles;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        const beamConeHalfAngle = halfSpread * 1.15;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        const glowOuterRadius = baseRadius * 1.1;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        for (let i = 0; i < particles.length; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const p = particles[i];"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          // Slow upward float and gentle ambient wave"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Boosted upward velocity and organic drift"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          p.y += p.speedY;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          p.x += p.speedX + Math.sin(time * 0.45 + p.driftPhase) * 0.0001;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Wrap boundaries organically"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          p.x += p.speedX;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Subtle orbital swirl toward/around center"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          p.swirlAngle += p.swirlSpeed;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          p.x += Math.cos(p.swirlAngle) * 0.00015;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Wrap boundaries smoothly"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (p.y < -0.02) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            p.y = 1.02;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            p.x = Math.random();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (p.x < -0.02) p.x = 1.02;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          if (p.x > 1.02) p.x = -0.02;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const px = p.x * width;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          const py = p.y * height;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          // Calculate angle and distance from top-center light origin"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dx = px - ox;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dy = py - oy;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const dist = Math.hypot(dx, dy);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const pAngle = Math.atan2(dy, dx);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Angular difference relative to downward beam direction (Math.PI / 2)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          let diff = pAngle - angle;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          while (diff > Math.PI) diff -= Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          while (diff < -Math.PI) diff += Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const absDiff = Math.abs(diff);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Determine if particle is inside the central conical light beam"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          let inBeam = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (absDiff < beamConeHalfAngle && dist < reach * 0.95 && py >= oy) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const lateral = 1 - absDiff / beamConeHalfAngle;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const longitudinal = Math.max(0, 1 - dist / (reach * 0.95));"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            inBeam = Math.pow(lateral, 1.25) * (0.35 + 0.65 * longitudinal);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Twinkle oscillation"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          const twinkle = 0.72 + 0.28 * Math.sin(time * p.twinkleFreq + p.twinklePhase);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          if (inBeam > 0.05) {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            // Particle catches the light inside the central beam"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const beamBoost = inBeam * 0.75 * intensity;"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const alpha = Math.min(1.0, (p.baseAlpha + beamBoost) * twinkle);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            const renderedRadius = p.radius * (1 + inBeam * 0.4);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            // Soft cyan glint aura"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "          // Radial distance from exact center"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const distToCenter = Math.hypot(px - cx, py - cy);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Calculate illumination factor inside the central glow"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          let inGlow = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (distToCenter < glowOuterRadius) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            inGlow = Math.max(0, 1 - distToCenter / glowOuterRadius);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Non-linear power curve for dramatic central brilliance"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            inGlow = Math.pow(inGlow, 1.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          // Twinkle frequency"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          const twinkle = 0.70 + 0.30 * Math.sin(time * p.twinkleFreq + p.twinklePhase);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          if (inGlow > 0.05) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Particle catches the energized central glow!"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const glowBoost = inGlow * 0.85 * intensity;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const alpha = Math.min(1.0, (p.baseAlpha + glowBoost) * twinkle);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const renderedRadius = p.radius * (1 + inGlow * 0.55);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Radiant glint aura"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.globalCompositeOperation = \'screen\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.fillStyle = hexToRgba(coreColor, inBeam * 0.35 * intensity);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ctx.arc(px, py, renderedRadius * 2.8, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            // Bright sparkling core catching light"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ctx.fillStyle = inBeam > 0.38 ? hexToRgba(\'#e4fcff\', alpha) : hexToRgba(coreColor, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            ctx.fillStyle = hexToRgba(coreColor, inGlow * 0.45 * intensity);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.arc(px, py, renderedRadius * 3.2, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            // Brilliant luminous star core"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.fillStyle = inGlow > 0.45 ? hexToRgba(\'#ffffff\', alpha) : hexToRgba(coreColor, alpha);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.arc(px, py, renderedRadius, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          } else {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            // Faint ambient star twinkling outside the beam"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "            // Faint starry dust twinkling in outer velvet navy"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            const alpha = p.baseAlpha * twinkle;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.save();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.fillStyle = `rgba(215, 230, 255, ${alpha.toFixed(3)})`;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.arc(px, py, p.radius, 0, Math.PI * 2);"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.fill();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "            ctx.restore();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "          }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      }"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.restore();"
