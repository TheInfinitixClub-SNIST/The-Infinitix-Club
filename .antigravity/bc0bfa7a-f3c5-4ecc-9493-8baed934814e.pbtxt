            lines {
              text: "      ctx.beginPath();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      for (let i = 0; i <= waveSteps; i++) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const theta = (i / waveSteps) * Math.PI * 2;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        // 3rd & 5th harmonic wave distortion creating liquid flowing ripples"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        const ripple = dynamicMotion"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
