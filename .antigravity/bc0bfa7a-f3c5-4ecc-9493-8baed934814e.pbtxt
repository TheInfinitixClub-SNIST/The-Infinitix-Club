              text: "      // 5. Solid velvety base background (deep midnight navy #0b0d19)"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // When illuminated, subtly lifts with a whisper of ambient navy luminescence"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      // 3. Solid velvety base background (deep midnight navy #0b0d19)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      if (isIlluminated) {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        ctx.fillStyle = \'#0e1122\';"
