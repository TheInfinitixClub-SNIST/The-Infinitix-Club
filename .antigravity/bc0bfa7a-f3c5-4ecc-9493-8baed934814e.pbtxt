              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      gradAmbient.addColorStop(1.0, \'rgba(11, 13, 25, 0)\');"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ctx.fillStyle = gradAmbient;"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
